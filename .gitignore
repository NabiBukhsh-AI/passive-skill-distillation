# --- private specification and research files (live in the separate private repo) ---
.spec
.spec/
docs/spec/
*.private.md

# --- python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# --- tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.tox/

# --- secrets and local config ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
configs/local/
.claude/settings.local.json

# --- data, artifacts, run outputs (never commit these) ---
data/
corpora/
trajectories/
artifacts/
runs/
outputs/
*.parquet
*.jsonl
*.duckdb
*.sqlite3
mlruns/
wandb/

# --- distilled skills and transcripts (operational artifacts, not source) ---
skills_out/
distill_out/
transcripts/

# --- benchmark assets (large, pinned externally) ---
benchmarks/_assets/
alfworld_data/
spreadsheetbench_data/

# --- infrastructure state ---
*.tfstate
*.tfstate.*
.terraform/
kubeconfig*

# --- editors and os ---
.idea/
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp

# --- test fixtures are SOURCE, not data ---
# The data rules above (trajectories/, *.jsonl, *.parquet) would otherwise exclude
# tests/fixtures/trajectories/ and tests/fixtures/pii/, which spec Section 18 requires
# to be committed. Fixture corpora with hand-computed expected tables are the only
# thing that makes the analyzers verifiable (TASK-018 .. TASK-022).
!tests/fixtures/**
